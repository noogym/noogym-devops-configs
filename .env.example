# Copy to .env for local runs, or define these variables in Coolify.

APIM_HOSTNAME=localhost
APIM_ADMIN_USER=admin
APIM_ADMIN_PASSWORD=change-me-admin-password

# Generate a unique 64-character hex key before the first startup.
# PowerShell:
# $bytes = [byte[]]::new(32); [System.Security.Cryptography.RandomNumberGenerator]::Fill($bytes); -join ($bytes | ForEach-Object { $_.ToString("x2") })
APIM_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

APIM_MGT_BASE_URL=https://localhost:9443
APIM_DEVPORTAL_URL=https://localhost:9443/devportal
APIM_GATEWAY_HTTP_URL=http://localhost:8280
APIM_GATEWAY_HTTPS_URL=https://localhost:8243
APIM_GATEWAY_WS_URL=ws://localhost:9099
APIM_GATEWAY_WSS_URL=wss://localhost:8099
APIM_ANALYTICS_ENABLED=false
MOESIF_KEY=
CADDY_MGT_HOST=gateway.noogym.com
CADDY_GATEWAY_HOST=api-gateway.noogym.com
CADDY_INGRESS_NETWORK=coolify

MYSQL_ROOT_PASSWORD=change-me-root-password
SHARED_DB_NAME=shared_db
SHARED_DB_USER=sharedadmin
SHARED_DB_PASSWORD=change-me-shared-db-password
APIM_DB_NAME=apim_db
APIM_DB_USER=apimadmin
APIM_DB_PASSWORD=change-me-apim-db-password
